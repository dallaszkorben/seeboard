        btn_layout.setSpacing(10)
        btn_layout.setContentsMargins(10, 10, 10, 10)
        
        self.rec_button = QPushButton("REC")
        self.rec_button.setStyleSheet("""
            QPushButton {
                background-color: red;
                color: white;
                font-weight: bold;
