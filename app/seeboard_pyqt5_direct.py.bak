        # Status label
        self.status_label = QLabel("")
        self.status_label.setFont(QFont("Helvetica", meta_font_size))
        self.status_label.setStyleSheet(f"color: red; background-color: black;")
        self.status_label.setAlignment(Qt.AlignCenter)
